SOFT_CREDIT_CHECK_CONSENT_VERSION=2026-07-30-v1

# Set to 1 in development if you want deterministic mock score results without hitting Experian.
EXPERIAN_SOFT_PULL_USE_MOCK=0

# Real Experian or proxy endpoint for soft credit pulls.
EXPERIAN_SOFT_PULL_URL=
EXPERIAN_OAUTH_TOKEN_URL=
EXPERIAN_OAUTH_CLIENT_ID=
EXPERIAN_OAUTH_CLIENT_SECRET=
EXPERIAN_OAUTH_USERNAME=
EXPERIAN_OAUTH_PASSWORD=
EXPERIAN_OAUTH_SCOPE=user

# Choose the auth combination that matches your Experian or middleware setup.
EXPERIAN_SOFT_PULL_BEARER_TOKEN=
EXPERIAN_SOFT_PULL_USERNAME=
EXPERIAN_SOFT_PULL_PASSWORD=
EXPERIAN_SOFT_PULL_API_KEY=
EXPERIAN_SOFT_PULL_API_KEY_HEADER=x-api-key

# Optional timeout override in milliseconds.
EXPERIAN_SOFT_PULL_TIMEOUT_MS=15000

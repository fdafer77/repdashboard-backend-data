SOFT_CREDIT_CHECK_CONSENT_VERSION=2026-07-30-v1

# Optional per-user admin dashboard passwords.
ADMIN_DASHBOARD_PASSWORD_FAROUK_DAFER=
ADMIN_DASHBOARD_PASSWORD_ZACH_RISHEQ=
ADMIN_DASHBOARD_PASSWORD_CAPRIZIO_FORNARO=

# Set to 1 in development if you want deterministic mock score results without hitting Experian.
EXPERIAN_SOFT_PULL_USE_MOCK=0

# Real Experian or proxy endpoint for soft credit pulls.
EXPERIAN_SOFT_PULL_URL=
EXPERIAN_OAUTH_TOKEN_URL=
EXPERIAN_OAUTH_CLIENT_ID=
EXPERIAN_OAUTH_CLIENT_SECRET=
EXPERIAN_OAUTH_USERNAME=
EXPERIAN_OAUTH_PASSWORD=
EXPERIAN_OAUTH_SCOPE=user
EXPERIAN_CLIENT_REFERENCE_ID=SBMYSQL
EXPERIAN_REQUESTOR_SUBSCRIBER_CODE=
EXPERIAN_PERMISSIBLE_PURPOSE_TYPE=
EXPERIAN_PERMISSIBLE_PURPOSE_TERMS=
EXPERIAN_PERMISSIBLE_PURPOSE_ABBREVIATED_AMOUNT=
EXPERIAN_RISK_MODEL_INDICATORS=
EXPERIAN_RISK_MODEL_SCORE_PERCENTILE=
EXPERIAN_SUMMARY_TYPES=
EXPERIAN_OUTPUT_TYPE=
EXPERIAN_OUTPUT_HEADING=

# Choose the auth combination that matches your Experian or middleware setup.
EXPERIAN_SOFT_PULL_BEARER_TOKEN=
EXPERIAN_SOFT_PULL_USERNAME=
EXPERIAN_SOFT_PULL_PASSWORD=
EXPERIAN_SOFT_PULL_API_KEY=
EXPERIAN_SOFT_PULL_API_KEY_HEADER=x-api-key

# Optional timeout override in milliseconds.
EXPERIAN_SOFT_PULL_TIMEOUT_MS=15000

# Canopy EA-active client sync.
# Keep disabled until the target endpoint and auth values are configured in Render.
CANOPY_SYNC_ENABLED=0
CANOPY_SYNC_TARGET_URL=
CANOPY_SYNC_AUTH_TOKEN=
CANOPY_SYNC_AUTH_HEADER=authorization
CANOPY_SYNC_AUTH_SCHEME=Bearer
CANOPY_SYNC_POLL_MS=60000
CANOPY_SYNC_MAX_ATTEMPTS=6
CANOPY_SYNC_STARTUP_BACKFILL=0
CANOPY_SYNC_ACTIVE_EA_STATUSES=Pending EA Review,Ready for Resolution Review,Ready for Resolution,Resolution In Progress,Awaiting Program

# Canopy OAuth for saved bearer tokens.
CANOPY_OAUTH_APP_URL=https://app.canopytax.com
CANOPY_OAUTH_API_URL=https://api.canopytax.com
CANOPY_OAUTH_TOKEN_URL=https://api.canopytax.com/public/v3/token
CANOPY_OAUTH_CLIENT_ID=
CANOPY_OAUTH_CLIENT_SECRET=
CANOPY_OAUTH_REDIRECT_URL=https://api.taxrefresh.com/api/canopy/callback
CANOPY_OAUTH_SCOPE=contacts:read
CANOPY_OAUTH_ENCRYPTION_KEY=
CANOPY_OAUTH_STATE_SECRET=
CANOPY_OAUTH_SUCCESS_REDIRECT=
CANOPY_OAUTH_FAILURE_REDIRECT=
